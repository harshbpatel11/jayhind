# Compose-level settings only (not the per-service app secrets — those stay
# in each jayhind-*/​.env, see that repo's .env.example).
# Copy to `.env` in this repo's root before running `docker compose up`.

# Root password for the Dockerized MySQL. Matches DB_PASS=root already used
# in the app repos' .env files by convention — change both together.
MYSQL_ROOT_PASSWORD=root
