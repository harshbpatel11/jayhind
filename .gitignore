# This repo (jayhind) is orchestration/docs only — dev.sh, README, ops
# runbooks. The 6 sub-project repos are tracked as git submodules (see
# .gitmodules) rather than being excluded here. Everything else below is
# local runtime/data state that must never be committed anywhere.

# Live runtime data — real/dev DB data, uploaded files, never git
/database/
/uploads/
/uploads-staging/
/client-uploads/
/client-uploads-staging/

# Generated / regenerable output
/graphify-out/
/.graphifyignore
/_ops/nightly-logs/

# DB dumps / backups — binary, potentially large, never git
/_prod-backups/
*.sql
*.sql.gz

# Secrets / keys — never git, regardless of where they land
*.key
*.key.pub
*.pem
.env
.env.*
!.env.example

# Tooling / editor local state
/.claude/
/.vscode/
.DS_Store

# Node (in case any orchestration scripts grow deps here)
/node_modules/
*.log

# dev.sh runtime state
/.dev-logs/
/.dev-pids/
