# This repo (jayhind) is orchestration/docs only — dev.sh, README, ops
# runbooks. Everything below is either an independent sibling git repo
# (never nested content of this one), or local runtime/data state that must
# never be committed anywhere.

# The 6 sub-project repos — each is its own independent git repository
/jayhind-admin-back/
/jayhind-admin-front/
/jayhind-client-back/
/jayhindi-client-front/
/jayhind-ocr-service/
/qa-artifacts/

# Unrelated projects sharing this box — not part of Jayhind, never touch
/tb_ai_bid/
/tender-dock/

# Live runtime data — real/dev DB data, uploaded files, never git
/database/
/uploads/
/uploads-staging/
/client-uploads/
/client-uploads-staging/

# Generated / regenerable output
/graphify-out/
/.graphifyignore
/_ops/nightly-logs/

# DB dumps / backups — binary, potentially large, never git
/_prod-backups/
*.sql
*.sql.gz

# Secrets / keys — never git, regardless of where they land
*.key
*.key.pub
*.pem
.env
.env.*
!.env.example

# Tooling / editor local state
/.claude/
/.vscode/
.DS_Store

# Node (in case any orchestration scripts grow deps here)
/node_modules/
*.log
