# This repo (jayhind) is orchestration/docs only — dev.sh, README, ops
# runbooks. Everything below is either an independent git repo cloned INSIDE
# this one (never nested content of this repo itself), or local runtime/data
# state that must never be committed anywhere.

# The 6 sub-project repos — each is its own independent git repository,
# cloned inside this one (see README.md "Getting the code")
/jayhind-admin-back/
/jayhind-admin-front/
/jayhind-client-back/
/jayhindi-client-front/
/jayhind-ocr-service/
/qa-artifacts/

# Live runtime data — real/dev DB data, uploaded files, never git
/database/
/uploads/
/uploads-staging/
/client-uploads/
/client-uploads-staging/

# Generated / regenerable output
/graphify-out/
/.graphifyignore
/_ops/nightly-logs/

# DB dumps / backups — binary, potentially large, never git
/_prod-backups/
*.sql
*.sql.gz
# ...except the Dockerized MySQL's init script, which is infra code, not a dump.
!/docker/mysql/init/*.sql

# Secrets / keys — never git, regardless of where they land
*.key
*.key.pub
*.pem
.env
.env.*
!.env.example

# Tooling / editor local state
/.claude/
/.vscode/
.DS_Store

# Node (in case any orchestration scripts grow deps here)
/node_modules/
*.log
