[Unit]
Description=Jayhind Master Hub backend — dev (O1.4)
After=network.target mysql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/jayhind-admin-back
Environment=PATH=/home/ubuntu/.nvm/versions/node/v26.5.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.nvm/versions/node/v26.5.0/bin/npm start
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/ubuntu/projects/jayhind-admin-back/logs/dev-stdout.log
StandardError=append:/home/ubuntu/projects/jayhind-admin-back/logs/dev-stderr.log

[Install]
WantedBy=multi-user.target
