[Unit]
Description=Jayhind Master Hub frontend — STAGING (O1.3)
After=network.target jayhind-admin-back-staging.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/jayhind-admin-front
Environment=PATH=/home/ubuntu/.nvm/versions/node/v26.5.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.nvm/versions/node/v26.5.0/bin/npx ng serve --configuration staging --port 4501 --host 127.0.0.1
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/ubuntu/projects/jayhind-admin-front/logs/staging-stdout.log
StandardError=append:/home/ubuntu/projects/jayhind-admin-front/logs/staging-stderr.log

[Install]
WantedBy=multi-user.target
