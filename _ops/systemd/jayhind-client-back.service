[Unit]
Description=Jayhind Client ERP backend — dev (O1.4)
After=network.target mysql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/jayhind/jayhind-client-back
Environment=PATH=/home/ubuntu/.nvm/versions/node/v26.5.0/bin:/usr/local/bin:/usr/bin:/bin
# npm start (not `node dist/...`), deliberately: this is the actual dev
# environment — hot-reload via `nest start --watch` is the whole point, unlike
# the staging units which run a static build on purpose. `npm start` itself
# frees the port first (`fuser -k 3000/tcp || true`), so a systemd restart
# after a crash is not blocked by a stale bind.
ExecStart=/home/ubuntu/.nvm/versions/node/v26.5.0/bin/npm start
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/ubuntu/projects/jayhind/jayhind-client-back/logs/dev-stdout.log
StandardError=append:/home/ubuntu/projects/jayhind/jayhind-client-back/logs/dev-stderr.log

[Install]
WantedBy=multi-user.target
