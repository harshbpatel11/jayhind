[Unit]
Description=Jayhind Client ERP backend — STAGING (O1.3)
After=network.target mysql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/jayhind/jayhind-client-back
EnvironmentFile=/home/ubuntu/projects/jayhind/jayhind-client-back/.env.staging
Environment=PATH=/home/ubuntu/.nvm/versions/node/v26.5.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.nvm/versions/node/v26.5.0/bin/node dist/src/main.js
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/ubuntu/projects/jayhind/jayhind-client-back/logs/staging-stdout.log
StandardError=append:/home/ubuntu/projects/jayhind/jayhind-client-back/logs/staging-stderr.log

[Install]
WantedBy=multi-user.target
